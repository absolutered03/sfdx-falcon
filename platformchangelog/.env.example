# Postgres (Railway, Neon or local). Required by the site, seed and ingest.
DATABASE_URL=postgres://user:pass@localhost:5432/platformchangelog

# LLM: one call per candidate item, hard-capped per run.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
MAX_LLM_CALLS_PER_RUN=40

# Basic auth for /admin (the only non-public path).
ADMIN_USER=editor
ADMIN_PASSWORD=change-me

# Canonical site URL. Leave unset in production (defaults to https://platformchangelog.dev).
# SITE_URL=http://localhost:3000
